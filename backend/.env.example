# =========================================================
# NEXT HIRE - Environment Configuration Example (Phases 1-10)
# Master of Computer Applications (MCA) Academic Project
# =========================================================

# 1. Database Configuration (MySQL / Cloud Database)
# In production, set to your Cloud MySQL instance (e.g. AWS RDS, Aiven, PlanetScale)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=nexthire_db
DB_USER=root
DB_PASSWORD=your_mysql_password_here

# 2. Flask Security & Session Encryption
# Generate a strong key for production (e.g. python -c "import secrets; print(secrets.token_hex(32))")
SECRET_KEY=replace_with_a_secure_random_key_for_production
FLASK_ENV=production
PORT=5000

# 3. AI API Keys (Optional - System will fall back to Academic Heuristic NLP Evaluator if omitted)
# Google Gemini API Key
GEMINI_API_KEY=your_gemini_api_key_here
# OpenAI API Key (Alternative)
OPENAI_API_KEY=your_openai_api_key_here

# 4. CORS & Host Restrictions
CORS_ORIGINS=*
